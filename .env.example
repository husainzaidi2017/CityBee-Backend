# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated list; * allows all (dev only).
CORS_ORIGINS=*

# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://uqjhuiylvfafuqehuzwm.supabase.co
SUPABASE_ANON_KEY=
# Postgres connection string used by the API for data queries (PostGIS).
# Session pooler (port 5432) is recommended for long-running servers;
# transaction pooler (6543) for serverless.
SUPABASE_DB_URL=postgresql://postgres.uqjhuiylvfafuqehuzwm:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# Only needed for auth-admin operations (optional at first).
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary ────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google (server-side keys — never in Flutter) ──────────────────────────
GOOGLE_MAPS_SERVER_KEY=
